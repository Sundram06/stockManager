{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "backend",
      "port": 3000
    },
    {
      "name": "backend-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:sandbox"
      ],
      "cwd": "backend",
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    }
  ]
}